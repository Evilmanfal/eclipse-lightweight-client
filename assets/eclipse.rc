#include <winver.h>

1 ICON "eclipse.ico"

1 VERSIONINFO
FILEVERSION 0,8,5,0
PRODUCTVERSION 0,8,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Eclipse Native contributors\0"
            VALUE "FileDescription", "Eclipse - Native Discord Client\0"
            VALUE "FileVersion", "0.8.5\0"
            VALUE "InternalName", "eclipse-native\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Eclipse Native contributors\0"
            VALUE "OriginalFilename", "Eclipse.exe\0"
            VALUE "ProductName", "Eclipse\0"
            VALUE "ProductVersion", "0.8.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
